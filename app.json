{
  "expo": {
    "name": "Agricultural Survey",
    "slug": "agrisurvey-mobile",
    "owner": "surya-developers-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.suryar.agrisurvey",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriSurvey needs your location to map field parcels and audit crop coordinates.",
          "locationAlwaysAndWhenInUsePermission": "AgriSurvey needs your location to map field parcels and audit crop coordinates."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgriSurvey needs access to your photos to attach field inspection images.",
          "cameraPermission": "AgriSurvey needs camera access to capture geotagged photos of fields, crops, and soil profiles."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "73087f80-2b16-41ed-bfc2-739a18884408"
      }
    }
  }
}
